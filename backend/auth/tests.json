{
  "tests": [
    {
      "name": "Register new user",
      "method": "POST",
      "path": "/?action=register",
      "body": {"username": "TestUser999", "email": "test999@example.com", "password": "secret123"},
      "expectedStatus": 200,
      "bodyMatcher": "none"
    },
    {
      "name": "Login with wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"login": "testuser999", "password": "wrongpassword"},
      "expectedStatus": 401,
      "bodyMatcher": "none"
    },
    {
      "name": "Me without token",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "bodyMatcher": "none"
    }
  ]
}